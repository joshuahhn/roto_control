+    labels = ('Ready', 'Trigger') if parameter.mode == 'pulse' else ('Off', 'On')
+    strings = tuple(byte for label in labels for byte in text13(label)) if steps else ()
+    if parameter.key[0] == 'knob' and parameter.menu_labels:
